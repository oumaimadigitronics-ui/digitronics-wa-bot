PORT=3000

# OpenAI
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o-mini

# WooCommerce API
WC_BASE_URL=https://your-woocommerce-site.com
WC_CONSUMER_KEY=ck_****
WC_CONSUMER_SECRET=cs_****

# Offers refresh
OFFERS_REFRESH_MS=300000
OFFERS_REFRESH_TOKEN=optional-refresh-token

# Webhook security
WANOTIFIER_TOKEN=optional-webhook-token
WANOTIFIER_HMAC_SECRET=optional-hmac-secret
WANOTIFIER_HMAC_HEADER=x-signature
WANOTIFIER_TS_HEADER=x-timestamp
WANOTIFIER_MAX_SKEW_SECONDS=300

# Behavior tuning
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=25
MEMORY_TTL_HOURS=24
MEMORY_MAX_MESSAGES=12
ORDER_FORM_URL=https://example.com/order-form
