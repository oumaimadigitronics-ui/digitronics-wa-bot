# Feature flags
# FEATURE_STRICT_CATEGORY_SWITCH=1 enables explicit appliance category overrides and brand-only TV defaults
FEATURE_STRICT_CATEGORY_SWITCH=0
# FEATURE_OFFER_TAIL_COMPACT=1 uses a shorter offers footer to fit more items
FEATURE_OFFER_TAIL_COMPACT=0
# FEATURE_STRICT_STOCK_FILTER=1 removes out-of-stock offers before ranking
FEATURE_STRICT_STOCK_FILTER=0
# FEATURE_SHOW_SKU_IN_OFFERS=1 includes SKU/model in offer lines
FEATURE_SHOW_SKU_IN_OFFERS=0
# FEATURE_LEGACY_OFFER_LINE=1 keeps the previous offer line formatting for rollback
FEATURE_LEGACY_OFFER_LINE=0
# FEATURE_LEGACY_OFFER_DISPLAY_NAME=1 keeps legacy display name priority for rollback
FEATURE_LEGACY_OFFER_DISPLAY_NAME=0
# FEATURE_OFFER_ITEM_EMOJI_FORMAT=1 uses emoji offer item blocks in premium offers
FEATURE_OFFER_ITEM_EMOJI_FORMAT=0
# FEATURE_OFFERS_BOX_HEADER=0 removes ASCII box header in offers lists
FEATURE_OFFERS_BOX_HEADER=0
# FEATURE_GREETING_FOLLOWUP_OFFERS=1 sends fallback offers as a followup after greeting
FEATURE_GREETING_FOLLOWUP_OFFERS=0
# FEATURE_GREETING_LANG_FROM_TEXT=1 derives greeting language from opener text (fr/ar only)
FEATURE_GREETING_LANG_FROM_TEXT=0
# FEATURE_GREETING_I18N=1 enables greeting templates for Arabic and French
FEATURE_GREETING_I18N=0
# FEATURE_FORCE_AR_FR=1 forces replies to Arabic or French only
FEATURE_FORCE_AR_FR=0
# FEATURE_WA_HARD_CAP_4096=1 enforces a WhatsApp-friendly 4096 character cap
FEATURE_WA_HARD_CAP_4096=0
# FEATURE_ALLOW_MAPS_URLS=1 allows Google Maps links in contact replies
FEATURE_ALLOW_MAPS_URLS=0

# Reply sizing
MAX_WA_REPLY_CHARS=4096
